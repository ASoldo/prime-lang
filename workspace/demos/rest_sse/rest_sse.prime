//! Authoritative state machine for the loopback HTTP adapter.
module demos::rest_sse;

import core::types;

fn main() {
  let mut int32 value = 0;
  let mut int32 id = 0;
  out(`READY {id} {value}`);
  while let Result::Ok(command) = in[string]("") {
    if command == "STOP" {
      break;
    }
    if command == "GET" {
      out(`STATE {id} {value}`);
    } else if command == "SET" {
      match in[int32]("") {
        Result::Ok(next) => {
          if next >= 0 && next <= 1000 && id < 2147483647 {
            value = next;
            id = id + 1;
            out(`STATE {id} {value}`);
          } else {
            out("REJECT");
          }
        },
        Result::Err(_) => out("REJECT"),
      }
    } else {
      out("REJECT");
    }
  }
  out("STOPPED");
}
