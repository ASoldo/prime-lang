//! Shared board, tetromino and seven-bag rules.
library tetris::rules;

export prelude {
  COLS,
  ROWS,
  make_board,
  make_row_flags,
  board_get,
  board_get_at,
  reset_board,
  reset_row_flags,
  normalize_rotation,
  cell_x,
  cell_y,
  can_move,
  can_move_at,
  rotate_piece,
  rotate_piece_at,
  lock_piece,
  lock_piece_at,
  row_marked,
  mark_full_rows,
  mark_full_rows_at,
  cleared_rows_below,
  apply_marked_clears,
  apply_marked_clears_at,
  ghost_y,
  ghost_y_at,
  make_bag,
  draw_from_bag,
  draw_from_bag_at,
  add_score,
};

pub const COLS: int32 = 10;

pub const ROWS: int32 = 20;

const BOARD_CELLS: int32 = 200;

pub fn make_board() -> []int32 {
  let mut []int32 board = [];
  for _ in 0..BOARD_CELLS {
    board.push(0);
  }
  board
}

pub fn make_row_flags() -> []int32 {
  let mut []int32 flags = [];
  for _ in 0..ROWS {
    flags.push(0);
  }
  flags
}

pub fn board_get(board: []int32, x: int32, y: int32) -> int32 {
  board_get_at(board, 0, x, y)
}

pub fn board_get_at(board: []int32, base: int32, x: int32, y: int32) -> int32 {
  let mut int32 result = 1;
  if x >= 0 && x < COLS && y < ROWS {
    if y < 0 {
      result = 0;
    } else {
      result = slice_get_int(board, base + y * COLS + x, 1);
    }
  }
  result
}

fn board_set(board: []int32, x: int32, y: int32, value: int32) {
  board_set_at(board, 0, x, y, value);
}

fn board_set_at(board: []int32, base: int32, x: int32, y: int32, value: int32) {
  if x >= 0 && x < COLS && y >= 0 && y < ROWS {
    board[base + y * COLS + x] = value;
  }
}

pub fn reset_board(board: []int32) {
  for y in 0..ROWS {
    for x in 0..COLS {
      board_set(board, x, y, 0);
    }
  }
}

pub fn reset_row_flags(flags: []int32) {
  for y in 0..ROWS {
    flags[y] = 0;
  }
}

pub fn normalize_rotation(rotation: int32) -> int32 {
  let mut int32 value = rotation % 4;
  if value < 0 {
    value = value + 4;
  }
  value
}

fn select_cell(index: int32, first: int32, second: int32, third: int32, fourth: int32) -> int32 {
  let mut int32 value = first;
  if index == 1 {
    value = second;
  }
  if index == 2 {
    value = third;
  }
  if index == 3 {
    value = fourth;
  }
  value
}

pub fn cell_x(kind: int32, rotation: int32, index: int32) -> int32 {
  let int32 rot = normalize_rotation(rotation);
  let mut int32 value = 0;
  if kind == 1 {
    if rot == 0 || rot == 2 {
      value = select_cell(index, -1, 0, 1, 2);
    } else {
      value = 1;
    }
  }
  if kind == 2 {
    value = select_cell(index, 0, 1, 0, 1);
  }
  if kind == 3 {
    if rot == 0 {
      value = select_cell(index, 0, -1, 0, 1);
    }
    if rot == 1 {
      value = select_cell(index, 0, 0, 1, 0);
    }
    if rot == 2 {
      value = select_cell(index, -1, 0, 1, 0);
    }
    if rot == 3 {
      value = select_cell(index, 0, -1, 0, 0);
    }
  }
  if kind == 4 {
    if rot == 0 || rot == 2 {
      value = select_cell(index, 0, 1, -1, 0);
    } else {
      value = select_cell(index, 0, 0, 1, 1);
    }
  }
  if kind == 5 {
    if rot == 0 || rot == 2 {
      value = select_cell(index, -1, 0, 0, 1);
    } else {
      value = select_cell(index, 1, 1, 0, 0);
    }
  }
  if kind == 6 {
    if rot == 0 {
      value = select_cell(index, -1, -1, 0, 1);
    }
    if rot == 1 {
      value = select_cell(index, 0, 1, 0, 0);
    }
    if rot == 2 {
      value = select_cell(index, -1, 0, 1, 1);
    }
    if rot == 3 {
      value = select_cell(index, 0, 0, -1, 0);
    }
  }
  if kind == 7 {
    if rot == 0 {
      value = select_cell(index, 1, -1, 0, 1);
    }
    if rot == 1 {
      value = select_cell(index, 0, 0, 0, 1);
    }
    if rot == 2 {
      value = select_cell(index, -1, 0, 1, -1);
    }
    if rot == 3 {
      value = select_cell(index, -1, 0, 0, 0);
    }
  }
  value
}

pub fn cell_y(kind: int32, rotation: int32, index: int32) -> int32 {
  let int32 rot = normalize_rotation(rotation);
  let mut int32 value = 0;
  if kind == 1 {
    if rot == 1 || rot == 3 {
      value = select_cell(index, -1, 0, 1, 2);
    }
  }
  if kind == 2 {
    value = select_cell(index, 0, 0, 1, 1);
  }
  if kind == 3 {
    if rot == 0 {
      value = select_cell(index, -1, 0, 0, 0);
    }
    if rot == 1 {
      value = select_cell(index, -1, 0, 0, 1);
    }
    if rot == 2 {
      value = select_cell(index, 0, 0, 0, 1);
    }
    if rot == 3 {
      value = select_cell(index, -1, 0, 0, 1);
    }
  }
  if kind == 4 || kind == 5 {
    if rot == 0 || rot == 2 {
      value = select_cell(index, 0, 0, 1, 1);
    } else {
      value = select_cell(index, -1, 0, 0, 1);
    }
  }
  if kind == 6 {
    if rot == 0 {
      value = select_cell(index, -1, 0, 0, 0);
    }
    if rot == 1 {
      value = select_cell(index, -1, -1, 0, 1);
    }
    if rot == 2 {
      value = select_cell(index, 0, 0, 0, 1);
    }
    if rot == 3 {
      value = select_cell(index, -1, 0, 1, 1);
    }
  }
  if kind == 7 {
    if rot == 0 {
      value = select_cell(index, -1, 0, 0, 0);
    }
    if rot == 1 {
      value = select_cell(index, -1, 0, 1, 1);
    }
    if rot == 2 {
      value = select_cell(index, 0, 0, 0, 1);
    }
    if rot == 3 {
      value = select_cell(index, -1, -1, 0, 1);
    }
  }
  value
}

pub fn can_move(board: []int32, kind: int32, rotation: int32, x: int32, y: int32) -> bool {
  can_move_at(board, 0, kind, rotation, x, y)
}

pub fn can_move_at(board: []int32, base: int32, kind: int32, rotation: int32, x: int32, y: int32) -> bool {
  let mut bool valid = true;
  for index in 0..4 {
    let int32 px = x + cell_x(kind, rotation, index);
    let int32 py = y + cell_y(kind, rotation, index);
    if px < 0 || px >= COLS || py >= ROWS {
      valid = false;
    }
    if py >= 0 && board_get_at(board, base, px, py) != 0 {
      valid = false;
    }
  }
  valid
}

pub fn rotate_piece(board: []int32, kind: int32, rotation: int32, x: int32, y: int32, direction: int32) -> (int32, int32) {
  rotate_piece_at(board, 0, kind, rotation, x, y, direction)
}

pub fn rotate_piece_at(board: []int32, base: int32, kind: int32, rotation: int32, x: int32, y: int32, direction: int32) -> (int32, int32) {
  let desired = normalize_rotation(rotation + direction);
  let mut turned = rotation;
  let mut kicked_x = x;
  if can_move_at(board, base, kind, desired, x, y) {
    turned = desired;
  } else if can_move_at(board, base, kind, desired, x - 1, y) {
    turned = desired;
    kicked_x = x - 1;
  } else if can_move_at(board, base, kind, desired, x + 1, y) {
    turned = desired;
    kicked_x = x + 1;
  }
  return turned, kicked_x;
}

pub fn lock_piece(board: []int32, kind: int32, rotation: int32, x: int32, y: int32) {
  lock_piece_at(board, 0, kind, rotation, x, y);
}

pub fn lock_piece_at(board: []int32, base: int32, kind: int32, rotation: int32, x: int32, y: int32) {
  for index in 0..4 {
    let int32 px = x + cell_x(kind, rotation, index);
    let int32 py = y + cell_y(kind, rotation, index);
    if py >= 0 {
      board_set_at(board, base, px, py, kind);
    }
  }
}

fn row_full_at(board: []int32, base: int32, row: int32) -> bool {
  let mut bool full = true;
  for x in 0..COLS {
    if board_get_at(board, base, x, row) == 0 {
      full = false;
    }
  }
  full
}

pub fn row_marked(clear_rows: []int32, row: int32) -> bool {
  slice_get_int(clear_rows, row, 0) != 0
}

pub fn mark_full_rows(board: []int32, clear_rows: []int32) -> int32 {
  mark_full_rows_at(board, 0, clear_rows)
}

pub fn mark_full_rows_at(board: []int32, base: int32, clear_rows: []int32) -> int32 {
  reset_row_flags(clear_rows);

  let mut int32 cleared = 0;
  for y in 0..ROWS {
    if row_full_at(board, base, y) {
      cleared = cleared + 1;
      clear_rows[y] = 1;
    }
  }
  cleared
}

pub fn cleared_rows_below(clear_rows: []int32, row: int32) -> int32 {
  let mut int32 count = 0;
  let mut int32 y = row + 1;
  while y < ROWS {
    if row_marked(clear_rows, y) {
      count = count + 1;
    }
    y = y + 1;
  }
  count
}

pub fn apply_marked_clears(board: []int32, clear_rows: []int32) {
  apply_marked_clears_at(board, 0, clear_rows);
}

pub fn apply_marked_clears_at(board: []int32, base: int32, clear_rows: []int32) {
  let mut int32 write = ROWS - 1;
  let mut int32 read = ROWS - 1;
  while read >= 0 {
    if !row_marked(clear_rows, read) {
      for x in 0..COLS {
        board_set_at(board, base, x, write, board_get_at(board, base, x, read));
      }
      write = write - 1;
    }
    read = read - 1;
  }
  while write >= 0 {
    for x in 0..COLS {
      board_set_at(board, base, x, write, 0);
    }
    write = write - 1;
  }
  reset_row_flags(clear_rows);
}

pub fn ghost_y(board: []int32, kind: int32, rotation: int32, x: int32, y: int32) -> int32 {
  ghost_y_at(board, 0, kind, rotation, x, y)
}

pub fn ghost_y_at(board: []int32, base: int32, kind: int32, rotation: int32, x: int32, y: int32) -> int32 {
  let mut int32 drop_y = y;
  while can_move_at(board, base, kind, rotation, x, drop_y + 1) {
    drop_y = drop_y + 1;
  }
  drop_y
}

fn next_seed(seed: int32) -> int32 {
  let int64 wide = cast[int64](seed) * 1103515245 + 12345;
  let mut int32 next = wide % 2147483647;
  if next < 0 {
    next = 0 - next;
  }
  if next == 0 {
    next = 17;
  }
  next
}

pub fn make_bag() -> []int32 {
  let mut []int32 bag = [];
  for kind in 1..8 {
    bag.push(kind);
  }
  bag
}

fn refill_bag_at(bag: []int32, base: int32, seed: int32) -> int32 {
  for kind in 1..8 {
    bag[base + kind - 1] = kind;
  }

  let mut int32 next = seed;
  let mut int32 index = 6;
  while index > 0 {
    next = next_seed(next);
    let int32 swap_index = next % (index + 1);
    let int32 value = slice_get_int(bag, base + index, 1);
    bag[base + index] = slice_get_int(bag, base + swap_index, 1);
    bag[base + swap_index] = value;
    index = index - 1;
  }
  next
}

pub fn draw_from_bag(bag: []int32, bag_index: int32, seed: int32) -> (int32, int32, int32) {
  draw_from_bag_at(bag, 0, bag_index, seed)
}

pub fn draw_from_bag_at(bag: []int32, base: int32, bag_index: int32, seed: int32) -> (int32, int32, int32) {
  let mut int32 index = bag_index;
  let mut int32 next = seed;
  if index >= 7 {
    next = refill_bag_at(bag, base, next);
    index = 0;
  }

  let int32 kind = slice_get_int(bag, base + index, 1);
  return kind, index + 1, next;
}

pub fn add_score(score: int32, level: int32, cleared: int32) -> int32 {
  let mut int32 result = score;
  if cleared == 1 {
    result = score + 100 * level;
  }
  if cleared == 2 {
    result = score + 300 * level;
  }
  if cleared == 3 {
    result = score + 500 * level;
  }
  if cleared >= 4 {
    result = score + 800 * level;
  }
  result
}
