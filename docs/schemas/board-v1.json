{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prime board report v1",
  "type": "object",
  "required": ["schema_version", "port", "chip", "description", "mac", "flash_bytes", "esptool_version", "prime_target"],
  "properties": {
    "schema_version": { "const": 1 },
    "port": { "type": "string" },
    "chip": { "type": "string" },
    "description": { "type": "string" },
    "mac": { "type": "string", "pattern": "^([a-f0-9]{2}:){5}[a-f0-9]{2}$" },
    "flash_bytes": { "type": "integer", "minimum": 1 },
    "esptool_version": { "type": "string" },
    "prime_target": { "type": ["string", "null"] },
    "image": { "type": "string" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "dependentRequired": { "image": ["sha256"], "sha256": ["image"] }
}
